+        }
+        FIXTURE_COUNTERS.set(None); // a driver query failure cannot reset the wait
+        assert_eq!(
+            u32_at(
+                &event_control(&mut serial, h, 5, 0x1b0044, &mask.to_le_bytes(), 0).unwrap(),
+                12
+            ),
+            Ok(UNSUPPORTED)
+        );
+        FIXTURE_COUNTERS.set(Some(counts));
+        assert!(serial.ready().is_empty());
