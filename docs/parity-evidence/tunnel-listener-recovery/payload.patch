+#[test]
+fn fixture_port_claim_survives_socket_handoff_and_releases_on_drop() {
+    let ip = "127.0.0.1".parse().unwrap();
+    let mut reservation = PortReservation::bind(ip);
+    let address = SocketAddr::new(ip, reservation.port());
+    reservation.release_listener();
+    // Deterministically force the exact candidate that bind(0) can select in the
+    // gap. A second fixture must reject it even though the kernel accepts bind.
+    let candidate = TcpListener::bind(address).unwrap();
+    let rejected = PortReservation::claim(candidate);
+    assert!(
+        matches!(rejected, Err(ref e) if e.kind() == std::io::ErrorKind::AddrInUse),
+        "a second fixture claimed the released forward port {address}"
+    );
+    drop(rejected);
+    drop(reservation);
+    let reclaimed = PortReservation::claim(TcpListener::bind(address).unwrap()).unwrap();
+    assert_eq!(reclaimed.port(), address.port());
+    println!("fixture candidate {address} rejected while claimed, available after drop");
+}
