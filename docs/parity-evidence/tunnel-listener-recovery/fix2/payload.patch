--- a/tests/tunnel_interop.rs
+++ b/tests/tunnel_interop.rs
@@ -446,18 +446,17 @@
     let ip = "127.0.0.1".parse().unwrap();
     let mut reservation = PortReservation::bind(ip);
     let address = SocketAddr::new(ip, reservation.port());
-    reservation.release_listener();
