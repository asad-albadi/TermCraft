      },
      {
        "offset": "0x64f1",
        "text": "0 .  clear digit"
      },
      {
        "offset": "0x6502",
        "text": "c   clear board"
      },
      {
        "offset": "0x6512",
        "text": "f   fix squares"
      },
      {
        "offset": "0x6522",
        "text": "n   new board"
      },
      {
        "offset": "0x6530",
        "text": "q   quit game"
      },
      {
        "offset": "0x653e",
        "text": "s   save"
      },
      {
        "offset": "0x6547",
        "text": "r   restart"
      },
      {
        "offset": "0x6553",
        "text": "u   undo last move"
      },
      {
        "offset": "0x6566",
        "text": "v   solve"
      },
      {
        "offset": "0x6570",
        "text": "?   request hint"
      }
    ],
    "limitations": []
  },
  {
    "game": "soliterm",
    "provenance": "recovered",
    "measured": false,
    "source_member": "CygUtils.plugin/bin/soliterm.exe",
    "decoded_sha256": "61135275b72804d4eac811c7f71e53c9c65c3029acba7e2912a62f98fa1ab610",
    "rules": "Solitaire; binary exposes --freecell and --klondike and --passes number option. Detailed legal-move rules not established.",
    "controls": "Click source card then destination; arrows move cursor; Space selects cards. Minimum terminal 68x20, q quits terminal-too-small prompt.",
    "source_strings": [
      {
        "offset": "0x6681",
        "text": "%s v%s"
      },
      {
        "offset": "0x6688",
        "text": "Solitaire games for your terminal, by Mobatek"
      },
      {
        "offset": "0x66b6",
        "text": "https://mobaxterm.mobatek.net"
      },
      {
        "offset": "0x66d4",
        "text": "Use your mouse to select and move cards:"
      },
      {
        "offset": "0x6700",
        "text": "click on a card, then click on the destination stack"
      },
      {
        "offset": "0x6738",
        "text": "You can also move cursor with keyboard arrows"
      },
      {
        "offset": "0x6768",
        "text": "and select cards with <SPACE> key."
      },
      {
        "offset": "0x678b",
        "text": "%-12s"
      },
      {
        "offset": "0x696c",
        "text": "Please increase your terminal size to at least 68x20 or press q to quit."
      },
      {
        "offset": "0x69b9",
        "text": "usage: %s [-v|--version] [-h|--help] [-f|--freecell] [-k|--klondike [-p|--passes=NUMBER]]"
      },
      {
        "offset": "0x6a14",
        "text": "    -f, --freecell Play freecell solitaire"
      },
      {
        "offset": "0x6a40",
        "text": "    -k, --klondike Play klondike solitaire"
      },
      {
        "offset": "0x6a6c",
        "text": "    -p, --passes   Number of passes through the deck (for klondike)"
      },
      {
        "offset": "0x6ab0",
        "text": "    -v, --version  Show version"
      },
      {
        "offset": "0x6ad0",
        "text": "    -h, --help     Show this message"
      }
    ],
    "limitations": [
      "No claim that default variant or every in-game key is established."
    ]
  },
