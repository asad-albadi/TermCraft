[
  {
    "game": "greed",
    "provenance": "recovered",
    "measured": false,
    "source_member": "CygUtils.plugin/bin/greed.exe",
    "decoded_sha256": "6bd41af503c2acf433d5c878c3679a07f6376440f1d19e32c08162c8b6275d0d",
    "rules": "Erase the grid by moving N squares in a direction, N is first number in that direction. Cannot cross erased squares or leave grid. Game ends if no valid moves exist. Score is erased squares.",
    "controls": "hjklyubn or numeric keypad move; Ctrl-L redraw; p toggle valid move highlighting; q quit; ? help.",
    "source_strings": [
      {
        "offset": "0x286a",
        "text": "%s - Hit '?' for help."
      },
      {
        "offset": "0x2db4",
        "text": " The object of Greed is to erase as much of the screen as"
      },
      {
        "offset": "0x2df0",
        "text": " possible by moving around in a grid of numbers.  To move"
      },
      {
        "offset": "0x2e2c",
        "text": " your cursor, simply use the 'hjklyubn' keys or your number"
      },
      {
        "offset": "0x2e68",
        "text": " keypad.  Your location is signified by the '%c' symbol."
      },
      {
        "offset": "0x2ea4",
        "text": " When you move in a direction, you erase N number of grid"
      },
      {
        "offset": "0x2ee0",
        "text": " squares in that direction, N being the first number in that"
      },
      {
        "offset": "0x2f20",
        "text": " direction.  Your score reflects the total number of squares"
      },
      {
        "offset": "0x2f60",
        "text": " eaten.  Greed will not let you make a move that would have"
      },
      {
        "offset": "0x2f9c",
        "text": " placed you off the grid or over a previously eaten square"
      },
      {
        "offset": "0x2fd8",
        "text": " unless no valid moves exist, in which case your game ends."
      },
      {
        "offset": "0x3014",
        "text": " Other Greed commands are 'Ctrl-L' to redraw the screen,"
      },
      {
        "offset": "0x3050",
        "text": " 'p' to toggle the highlighting of the possible moves, and"
      },
      {
        "offset": "0x308c",
        "text": " 'q' to quit.  Command line options to Greed are '-s' to"
      },
      {
        "offset": "0x30c5",
        "text": " output the high score file."
      }
    ],
    "limitations": []
  },
