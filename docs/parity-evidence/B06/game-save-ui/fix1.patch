+        return Err("The existing target exceeds 256 KiB; choose a different save file.".into());
+    }
+    let mut bytes = Vec::new();
+    file.take(MAX_BYTES as u64 + 1)
+        .read_to_end(&mut bytes)
+        .map_err(|e| e.to_string())?;
+    if bytes.len() > MAX_BYTES {
+        return Err("The existing target exceeds 256 KiB; choose a different save file.".into());
+    }
