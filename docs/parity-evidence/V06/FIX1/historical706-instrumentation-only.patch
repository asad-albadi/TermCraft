+//! Private validation-only adapter. Not a product change.
+use super::*;
+use std::sync::{OnceLock,Mutex};
+fn dir()->PathBuf { PathBuf::from(std::env::var_os("V06_REPORT").expect("V06_REPORT required")) }
+fn emit(name:&str,value:serde_json::Value) { let _=fs::write(dir().join(name),serde_json::to_vec_pretty(&value).unwrap()); }
+impl Workspace {
+ pub(super) fn v06_control(&mut self,ctx:&Context) {
+  static START:OnceLock<()>=OnceLock::new();
+  START.get_or_init(|| { let ctx=ctx.clone();std::thread::spawn(move|| {let mut old=String::new(); loop {let cmd=fs::read_to_string(dir().join("command")).unwrap_or_default();if cmd!=old {old=cmd;ctx.request_repaint();}std::thread::sleep(Duration::from_millis(100));}}); });
+  static LAST:Mutex<String>=Mutex::new(String::new());
+  let cmd=fs::read_to_string(dir().join("command")).unwrap_or_default();let mut last=LAST.lock().unwrap();
+  if *last==cmd {return} *last=cmd.clone();drop(last);
+  let parts:Vec<_>=cmd.trim().splitn(2,' ').collect();
+  match parts.first().copied().unwrap_or("") {
+   "terminal"=> {self.start_with_launch(Session{name:"V06 Native Terminal".into(),protocol:"Local".into(),..Default::default()},Some(connection::Launch{rdp_profile:None,program:"/usr/bin/python".into(),args:vec!["-c".into(),format!("import os,tty\ntty.setraw(0)\nos.write(1,b'\\x1b[?2004h\\x1b[?1000h\\x1b[?1006hREADY')\nf=open({:?},'ab',buffering=0)\nwhile True:\n d=os.read(0,32768)\n if not d:break\n f.write(d)\n",dir().join("pty.bin").display().to_string())],directory:None}));}
+   "xserver"=> {self.page=Page::Servers;self.xserver.v06_start(ctx);},
+   "stop-xserver"=> self.xserver.v06_stop(),
+   "vnc"=> {let mut session=Session{name:"V06 Native Desktop".into(),protocol:"VNC".into(),host:"127.0.0.1".into(),port:std::env::var("V06_VNC_PORT").unwrap().parse().unwrap(),..Default::default()};session.vnc_options=harbor_workspace::desktop::vnc::VncOptions{embedded:true,allow_unencrypted:true,security:harbor_workspace::desktop::vnc::Security::None,..Default::default()};self.start(session);}
+   "detach"=> {if let Some(t)=self.tabs.last(){let id=t.id;self.detach_terminal(id);}}
+   "appearance"=> self.store.preferences.appearance=match parts.get(1).copied(){Some("Light")=>Appearance::Light,Some("Dark")=>Appearance::Dark,_=>Appearance::System},
+   "copy"=>ctx.copy_text(fs::read_to_string(dir().join("payload")).unwrap()),
+   "paste"=>{if let Some(t)=self.tabs.last(){let id=t.id;self.request_clipboard(id,ctx);}},
+   "capture"=>ctx.send_viewport_cmd(ViewportCommand::Screenshot(Default::default())),
+   "close"=>ctx.send_viewport_cmd(ViewportCommand::Close),
+   _=>{}
+  }
+ }
+ pub(super) fn v06_observe(&self,ctx:&Context) {
+  emit("xserver.json",self.xserver.v06_state());
+  emit("workspace.json",serde_json::json!({"theme":format!("{:?}",ctx.theme()),"appearance":format!("{:?}",self.store.preferences.appearance),"pixels_per_point":ctx.pixels_per_point(),"frame":self.frames,"tabs":self.tabs.len(),"detached":self.windows.detached()}));
+  for event in ctx.input(|i|i.events.clone()) {if let Event::Screenshot{image,..}=event {image::save_buffer(dir().join("capture.png"),&image.as_raw(),image.size[0] as u32,image.size[1] as u32,image::ColorType::Rgba8).unwrap();}}
+ }
+}
+pub(super) fn terminal(ui:&Ui,t:&TerminalTab,view:&super::terminal_mouse::Viewport) {
+ let events=ui.input(|i|i.events.clone());
+ let rows:Vec<_>=view.rows.iter().take(12).map(|(row,r)|serde_json::json!({"row":row,"min":[r.min.x,r.min.y],"max":[r.max.x,r.max.y]})).collect();
+ emit("terminal.json",serde_json::json!({"id":t.id,"plain":t.screen.plain(),"mouse_mode":format!("{:?}",t.screen.mouse_mode()),"ready":t.ready_for_input(),"focused":ui.input(|i|i.focused),"widget_focus":ui.memory(|m|m.has_focus(Id::new(("terminal-input",t.id)))),"clip":format!("{:?}",view.clip),"viewport":format!("{:?}",ui.ctx().viewport_id()),"pixels_per_point":ui.ctx().pixels_per_point(),"cell_width":view.cell_width,"rows":rows,"pointer":format!("{:?}",ui.input(|i|i.pointer.hover_pos()))}));
+ if events.iter().any(|e|matches!(e,Event::PointerButton{..})) {emit("pointer.json",serde_json::json!({"mode":format!("{:?}",t.screen.mouse_mode()),"cells":format!("{:?}",events.iter().filter_map(|e|if let Event::PointerButton{pos,..}=e{Some(view.cell(ui.ctx(),*pos))}else{None}).collect::<Vec<_>>()),"focused":ui.input(|i|i.focused),"widget_focus":ui.memory(|m|m.has_focus(Id::new(("terminal-input",t.id)))),"events":format!("{events:?}"),"ppp":ui.ctx().pixels_per_point()}));}
+}
+
+pub(super) fn confirm(ui:&Ui,response:&Response){emit("confirmation.json",serde_json::json!({"center":[response.rect.center().x,response.rect.center().y],"ppp":ui.ctx().pixels_per_point()}));}
+
+pub(super) fn desktop(ui:&Ui,id:u64,rect:Rect,width:u16,height:u16){emit("desktop.json",serde_json::json!({"id":id,"rect":[rect.min.x,rect.min.y,rect.max.x,rect.max.y],"width":width,"height":height,"ppp":ui.ctx().pixels_per_point(),"viewport":format!("{:?}",ui.ctx().viewport_id())}));}
