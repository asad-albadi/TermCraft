+impl State {
+ pub(super) fn v06_start(&mut self,ctx:&Context){self.bundle_root=Some(std::env::var_os("V06_ENGINE_PACKAGE").unwrap().into());self.probe_executable=Some(std::env::var_os("V06_PROBE_EXE").map(PathBuf::from).unwrap_or_else(||std::env::current_exe().unwrap()));self.start(ctx);}
+ pub(super) fn v06_state(&self)->serde_json::Value {serde_json::json!({"display":self.display.as_ref().map(|d|d.display()),"authority":self.display.as_ref().map(|d|d.authority_path()),"capabilities":self.capabilities,"error":self.error,"running":self.worker.is_some()})}
+ pub(super) fn v06_stop(&mut self){self.shutdown();self.display=None;}
