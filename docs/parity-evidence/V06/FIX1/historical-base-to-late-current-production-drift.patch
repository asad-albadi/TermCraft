+impl Default for PlayState {
+    fn default() -> Self {
+        Self {
+            launcher: false,
+            suspended: false,
+            session: None,
+            selected: 0,
+            colour: 1,
+            pencil: false,
+            help: false,
+            message: String::new(),
+            close_owner: None,
+            tick: None,
+            source: None,
+            count: 1,
+            variant: 0,
