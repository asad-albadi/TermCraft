+        let mut s = Sudoku::new(&mut Rng(42));
+        let mut solution = s.cells;
+        assert_eq!(count_solutions(&mut solution, 2, &mut 1_000_000), 1);
+        fn solve(cells: &mut [u8; 81]) -> bool {
+            if let Some(c) = cells.iter().position(|&v| v == 0) {
+                for v in 1..=9 {
+                    if allowed(cells, c, v) {
+                        cells[c] = v;
+                        if solve(cells) {
+                            return true;
+                        }
+                    }
+                }
+                cells[c] = 0;
+                false
+            } else {
+                true
+            }
