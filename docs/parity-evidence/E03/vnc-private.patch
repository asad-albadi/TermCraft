+        let mut c = VncServiceConfig::local(source, Secret::new("fixture"));
+        c.allow_unencrypted = true;
+        assert!(s.start_vnc(c).is_err());
+    }
+    let mut c = VncServiceConfig::local(
+        VncSource::X11 {
+            display: ":1".into(),
+        },
+        Secret::new("fixture"),
+    );
+    c.allow_unencrypted = true;
