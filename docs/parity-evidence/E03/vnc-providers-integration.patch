+                                self.selection,
+                                AtomEnum::STRING.into(),
+                                self.property,
+                                x11rb::CURRENT_TIME,
+                            )
+                            .map_err(error)?
+                            .check()
+                            .map_err(error)?;
+                            self.pending = Some(Instant::now());
+                        }
+                        continue;
+                    }
+                    let p = conn
+                        .get_property(true, self.window, self.property, AtomEnum::ANY, 0, 2049)
+                        .map_err(error)?
+                        .reply()
+                        .map_err(error)?;
