+            && owner != self.window
+            && self.pending.is_none()
+            && Instant::now() >= self.next_read
+        {
+            self.fallback = false;
+            conn.convert_selection(
+                self.window,
+                self.selection,
+                self.utf8,
+                self.property,
+                x11rb::CURRENT_TIME,
+            )
+            .map_err(error)?
+            .check()
+            .map_err(error)?;
+            self.pending = Some(Instant::now());
+            self.next_read = Instant::now() + Duration::from_millis(500);
+        }
+        conn.flush().map_err(error)?;
+        Ok(changed)
+    }
+}
