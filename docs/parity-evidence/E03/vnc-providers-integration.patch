+                            )
+                        } else {
+                            let reply = SelectionNotifyEvent {
+                                response_type: SELECTION_NOTIFY_EVENT,
+                                sequence: 0,
+                                time: e.time,
+                                requestor: e.requestor,
+                                selection: e.selection,
+                                target: e.target,
+                                property: 0,
+                            };
+                            let _ = conn
+                                .send_event(false, e.requestor, EventMask::NO_EVENT, reply)
+                                .map_err(error)?
+                                .check();
+                            continue;
+                        };
+                        if result.map_err(error)?.check().is_ok() {
+                            accepted = p;
+                        }
+                    }
+                    let reply = SelectionNotifyEvent {
+                        response_type: SELECTION_NOTIFY_EVENT,
+                        sequence: 0,
+                        time: e.time,
+                        requestor: e.requestor,
+                        selection: e.selection,
+                        target: e.target,
+                        property: accepted,
+                    };
+                    let _ = conn
+                        .send_event(false, e.requestor, EventMask::NO_EVENT, reply)
+                        .map_err(error)?
+                        .check();
