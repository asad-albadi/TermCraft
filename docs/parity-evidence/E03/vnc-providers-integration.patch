+        assert!(
+            server
+                .incoming(
+                    &(NOTIFY | TEXT).to_be_bytes(),
+                    ClipboardPolicy { receive: false },
+                    false
+                )
+                .unwrap()
+                .packet
+                .is_none()
+        );
+        let notify = server.upload("selected display text").unwrap();
+        assert_eq!(notify[0], 3);
+        let provide = server
+            .incoming(
+                &(REQUEST | TEXT).to_be_bytes(),
+                ClipboardPolicy { receive: false },
+                false,
+            )
+            .unwrap()
+            .packet
+            .unwrap();
+        assert_eq!(provide[0], 3);
+    }
+}
