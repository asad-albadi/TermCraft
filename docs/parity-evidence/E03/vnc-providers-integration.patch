+    }
+    #[test]
+    fn vnc_server_clipboard_unicode_negotiation_and_request_bounds() {
+        let mut server = Clipboard::default();
+        let mut client = Clipboard::default();
+        assert!(server.upload("α").is_err());
+        assert!(
+            server
+                .incoming(
+                    &(NOTIFY | TEXT).to_be_bytes(),
+                    ClipboardPolicy { receive: true },
+                    false
+                )
+                .is_err()
+        );
+        let caps = Clipboard::capabilities();
+        incoming(&mut server, &caps, true);
+        incoming(&mut client, &caps, true);
+        let notify = client.upload("α\né").unwrap();
+        let request = incoming(&mut server, &notify, true).packet.unwrap();
+        let provide = incoming(&mut client, &request, true).packet.unwrap();
+        assert_eq!(
+            incoming(&mut server, &provide, true).text.as_deref(),
+            Some("α\né")
+        );
+        assert!(
+            incoming(&mut server, &provide, true).text.is_none(),
+            "unsolicited Provide ignored"
+        );
+        assert!(client.upload(&"a".repeat(TEXT_LIMIT + 1)).is_err());
+        let request = incoming(&mut server, &notify, true).packet.unwrap();
+        let mut corrupt = incoming(&mut client, &request, true).packet.unwrap();
+        corrupt.push(0);
+        assert!(
+            server
+                .incoming(&corrupt[8..], ClipboardPolicy { receive: true }, false)
+                .is_err()
+        );
+    }
+    #[test]
+    fn vnc_server_clipboard_readonly_never_requests_remote_content() {
+        let mut server = Clipboard::default();
